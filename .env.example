# Environment Variables for BrightPath Web Studio
# Copy this file to .env and fill in your values
# For Netlify deployment, set these in your Netlify dashboard under Site Settings > Environment Variables

# WordPress Configuration
WORDPRESS_API_URL=https://your-wordpress-site.com
WORDPRESS_APP_PASSWORD=your-wordpress-app-password

# GoHighLevel API Key (for contact form submissions)
GHL_API_KEY=your-gohighlevel-api-key

# Newsletter signup (MailerLite) — see NEWSLETTER-SETUP.md
# Server-side only: never prefix the API key or group ID with VITE_.
NEWSLETTER_ENABLED=false
MAILERLITE_API_KEY=your-mailerlite-api-token
MAILERLITE_GROUP_ID=your-brightpath-updates-group-id
# Shows the signup form in the footer. Baked in at build time.
VITE_NEWSLETTER_ENABLED=false

# Contact form (Google Apps Script) — see google-apps-script/contact-form-handler/README.md
# Server-side only: never prefix these with VITE_.
CONTACT_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
CONTACT_SHARED_SECRET=same-value-as-the-scripts-SHARED_SECRET-property

# Frontend API URL (optional)
# Leave blank for production and `netlify dev`, where Netlify redirects handle routing.
# Set this only if you want the frontend to call a different backend directly.
# VITE_API_URL=

# Local Development
PORT=3002
NODE_ENV=development
